#ADF deployment from DEV to Test


trigger:
- none
   
stages:
  - stage: Test
    variables:
    - group: "eDARTfinadftestvg"
    jobs:
      - deployment: eDART_fin_adf_Test
        environment: 
         name: eDART_fin_adf_Test
      - job: "startbuildserver"
        pool:
         vmImage: windows-latest
        
        steps:
          - checkout : self
          
          
          - task: AzurePowerShell@5
            displayName: Start buildserver
            inputs:
              azureSubscription: 'WTW-ITCGHF-DEV (d30349e8-fd1d-4327-a4d6-0c15d41fea11)'
              ScriptType: 'FilePath'
              ScriptPath: '$(System.DefaultWorkingDirectory)/EDART-FIN-D-ADF/Buildserver/startserver.ps1'
              ScriptArguments: '-ResourceGroupName "$(Resourcegroupname)" -VmName "$(vmname)"'
              errorActionPreference: 'Stop'
              azurePowerShellVersion: 'LatestVersion'
      - job: Armtemplatedeployement
        dependsOn: startbuildserver
        pool:
           name: R2W-C-Dev
           demands:
           - agent.name -equals N20-CS-CRMBS01D

        displayName: Build
        steps:
         - checkout : self
         - task: AzurePowerShell@5
           
           displayName: Stop Triggers
           inputs:
             azureSubscription: 'WTW-ITCGHF-DEV (d30349e8-fd1d-4327-a4d6-0c15d41fea11)'
             ScriptType: 'FilePath'
             ScriptPath: '$(System.DefaultWorkingDirectory)/EDART-FIN-D-ADF/Triggers/Test/stoptriggers.ps1'
             ScriptArguments: '-ADFResourceGroupName "$(ADFResourceGroupName)" -Datafactoryname "$(Datafactoryname)"'
             errorActionPreference: 'Stop'
             azurePowerShellVersion: 'LatestVersion'
         - task: AzureResourceManagerTemplateDeployment@3
           displayName: Armtemplate deployment
           inputs:
             deploymentScope: 'Resource Group'
             azureResourceManagerConnection: 'eDART_SC_WIF'
             subscriptionId: 'd30349e8-fd1d-4327-a4d6-0c15d41fea11'
             action: 'Create Or Update Resource Group'
